# PUBLIC browser configuration. Never put a secret/service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# PUBLIC hCaptcha site key; its SECRET belongs only in Supabase Auth, never here.
# Use only one provider. hCaptcha takes precedence if both site keys are set.
VITE_HCAPTCHA_SITE_KEY=
# Alternative: PUBLIC Cloudflare Turnstile site key.
VITE_TURNSTILE_SITE_KEY=
# Optional canonical HTTPS origin for invitation links (no trailing slash).
VITE_APP_URL=
# Optional public support address for the privacy page.
VITE_SUPPORT_EMAIL=
# No Supabase configuration => explicitly labeled, single-device local preview.
