# VITE_ values are PUBLIC browser configuration. The server-only key is below.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# PUBLIC hCaptcha site key; its SECRET belongs only in Supabase Auth, never here.
# Use only one provider. hCaptcha takes precedence if both site keys are set.
VITE_HCAPTCHA_SITE_KEY=
# Alternative: PUBLIC Cloudflare Turnstile site key.
VITE_TURNSTILE_SITE_KEY=
# Optional canonical HTTPS origin for invitation links (no trailing slash).
VITE_APP_URL=
# Optional public support address for the privacy page.
VITE_SUPPORT_EMAIL=
# SERVER ONLY: set once in Vercel and .env.local for online board preparation.
# Use a Supabase secret/service_role key. NEVER add a VITE_ prefix to this variable.
# Supabase Settings > API Keys > Publishable and secret API keys (sb_secret_...).
# Local and Vercel environments are separate; restart Vite or redeploy after changes.
SUPABASE_SECRET_KEY=
# No Supabase configuration => explicitly labeled, single-device local preview.
