{
  "name": "subjective-guess-who",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:postgres": "node --experimental-strip-types scripts/postgres-check.ts",
    "notices": "node scripts/create-notices.mjs",
    "postinstall": "node --experimental-strip-types scripts/boards.ts --development",
    "predev": "node --experimental-strip-types scripts/boards.ts --development",
    "prebuild": "node --experimental-strip-types scripts/boards.ts && node scripts/brand.mjs",
    "pretypecheck": "node --experimental-strip-types scripts/boards.ts --development",
    "brand": "node scripts/brand.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fredoka": "^5.2.8",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/functions": "^3.11.3",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "opentype.js": "^2.0.0",
    "pg": "^8.16.3",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.1.0"
  }
}
