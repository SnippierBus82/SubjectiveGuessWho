{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subjective Guess Who external portrait production manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "styleId", "characters"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "styleId": {
      "const": "sgw-3d-adult-v1"
    },
    "characters": {
      "type": "array",
      "minItems": 72,
      "maxItems": 72,
      "items": {
        "$ref": "#/$defs/character"
      }
    }
  },
  "$defs": {
    "accessory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "color"],
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "style": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "color": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "color": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "traits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ageBand",
        "presentation",
        "skinTone",
        "faceShape",
        "nose",
        "eyes",
        "hair",
        "facialHair",
        "glasses",
        "headwear",
        "earrings",
        "outfit",
        "skinDetails",
        "expression"
      ],
      "properties": {
        "ageBand": {
          "enum": ["20s", "30s", "40s", "50s", "60s", "70s"]
        },
        "presentation": {
          "enum": ["feminine", "masculine", "androgynous"]
        },
        "skinTone": {
          "enum": [
            "very-light",
            "light",
            "medium-light",
            "medium",
            "medium-deep",
            "deep",
            "very-deep"
          ]
        },
        "faceShape": {
          "type": "string",
          "minLength": 1
        },
        "nose": {
          "type": "string",
          "minLength": 1
        },
        "eyes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color", "shape"],
          "properties": {
            "color": {
              "type": "string",
              "minLength": 1
            },
            "shape": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "hair": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style", "color", "texture"],
          "properties": {
            "style": {
              "type": "string",
              "minLength": 1
            },
            "color": {
              "type": ["string", "null"]
            },
            "texture": {
              "type": ["string", "null"]
            }
          }
        },
        "facialHair": {
          "$ref": "#/$defs/accessory"
        },
        "glasses": {
          "$ref": "#/$defs/accessory"
        },
        "headwear": {
          "$ref": "#/$defs/accessory"
        },
        "earrings": {
          "$ref": "#/$defs/accessory"
        },
        "outfit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "color", "accentColor"],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "color": {
              "type": "string",
              "minLength": 1
            },
            "accentColor": {
              "type": ["string", "null"]
            }
          }
        },
        "skinDetails": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "expression": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "fileName",
        "brief",
        "intendedTraits",
        "observedTraits",
        "altText",
        "generation",
        "image",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sgw-(00[1-9]|0[1-6][0-9]|07[0-2])$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["planned", "generated", "verified", "approved"]
        },
        "fileName": {
          "type": "string",
          "pattern": "^sgw-(00[1-9]|0[1-6][0-9]|07[0-2])\\.png$"
        },
        "brief": {
          "type": "string",
          "minLength": 30
        },
        "intendedTraits": {
          "$ref": "#/$defs/traits"
        },
        "observedTraits": {
          "anyOf": [
            {
              "$ref": "#/$defs/traits"
            },
            {
              "type": "null"
            }
          ]
        },
        "altText": {
          "type": ["string", "null"]
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "model", "seed", "styleReference", "generatedAt"],
          "properties": {
            "tool": {
              "type": ["string", "null"]
            },
            "model": {
              "type": ["string", "null"]
            },
            "seed": {
              "type": ["integer", "string", "null"]
            },
            "styleReference": {
              "type": ["string", "null"]
            },
            "generatedAt": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "sha256"],
          "properties": {
            "width": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "height": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "sha256": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewedBy", "reviewedAt", "notes"],
          "properties": {
            "reviewedBy": {
              "type": ["string", "null"]
            },
            "reviewedAt": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["verified", "approved"]
              }
            }
          },
          "then": {
            "properties": {
              "observedTraits": {
                "$ref": "#/$defs/traits"
              },
              "altText": {
                "type": "string",
                "minLength": 1
              },
              "review": {
                "properties": {
                  "reviewedBy": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["generated", "verified", "approved"]
              }
            }
          },
          "then": {
            "properties": {
              "image": {
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
